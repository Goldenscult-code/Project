* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
}

body {
    background-color: #000000;
    color: #ffffff;
}

:root {
	--row-gap: 10px;
	--column-gap: 10px;
	--column-padding: 10px;
}

.container {
	margin: 0 auto;
	width: 100%;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	gap: var(--row-gap);
}

.row {
	display: flex;
	flex-wrap: nowrap;
	gap: var(--column-gap);
	flex-direction: row-reverse;
    
}

[class^="col-"] {
	padding: var(--column-padding);
	display: flex;
	flex-grow: 1;
	flex-shrink: 1;
	align-items: center;
	border: 3px solid #5a5959;
    border-radius: 10px;
}


.col-header {
    display: flex;
    flex-basis: 16.6667%;
    justify-content: center;
}

